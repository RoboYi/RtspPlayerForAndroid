<resources>
    <style name="AppTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="colorAccent">@color/blue</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:statusBarColor">#05070B</item>
        <item name="android:navigationBarColor">#05070B</item>
        <item name="android:windowBackground">@drawable/ios_background</item>
        <item name="android:colorControlNormal">@color/ink</item>
        <item name="android:colorControlActivated">@color/blue</item>
        <item name="android:alertDialogTheme">@style/AppDialogTheme</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="AppTheme.Playback" parent="AppTheme">
        <item name="android:windowFullscreen">true</item>
    </style>

    <style name="AppDialogTheme" parent="Theme.AppCompat.Dialog.Alert">
        <item name="android:windowBackground">@drawable/card</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/muted</item>
        <item name="colorAccent">@color/blue</item>
    </style>
</resources>
