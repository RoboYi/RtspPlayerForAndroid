<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/player_surface_panel"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#05080D">

    <FrameLayout
        android:id="@+id/video_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#05080D">

        <GridLayout
            android:id="@+id/player_grid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:columnCount="1"
            android:rowCount="1" />

        <TextView
            android:id="@+id/preview_placeholder"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="32dp"
            android:text="@string/enter_rtsp_connect"
            android:textColor="#B8C5D5"
            android:textSize="17sp" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/connection_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginStart="16dp"
        android:layout_marginTop="82dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/card"
        android:elevation="14dp"
        android:orientation="vertical"
        android:padding="10dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/rtsp_url"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:background="@drawable/outline_button"
                android:hint="@string/rtsp_hint"
                android:importantForAutofill="no"
                android:inputType="textUri"
                android:paddingHorizontal="14dp"
                android:saveEnabled="false"
                android:singleLine="true"
                android:textColor="@color/ink"
                android:textColorHint="@color/muted"
                android:textSize="14sp" />

            <Button
                android:id="@+id/connect_button"
                android:layout_width="78dp"
                android:layout_height="46dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/primary_button"
                android:drawableStart="@drawable/ic_link"
                android:drawablePadding="0dp"
                android:gravity="center"
                android:minWidth="0dp"
                android:paddingHorizontal="5dp"
                android:text="@string/connect"
                android:textAllCaps="false"
                android:textColor="@android:color/white" />

            <ImageButton
                android:id="@+id/connection_collapse"
                android:layout_width="42dp"
                android:layout_height="46dp"
                android:layout_marginStart="6dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/collapse_panel"
                android:padding="9dp"
                android:src="@drawable/ic_chevron_up" />
        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/connection_quick_actions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="82dp"
        android:layout_marginEnd="16dp"
        android:elevation="16dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/history_dropdown_button"
            style="@style/OverlayTextButton"
            android:drawableStart="@drawable/ic_history"
            android:text="@string/playback_history_title" />

        <Button
            android:id="@+id/connection_reveal"
            style="@style/OverlayTextButton"
            android:layout_marginStart="6dp"
            android:drawableStart="@drawable/ic_link"
            android:text="@string/connect" />

        <Button
            android:id="@+id/device_search_reveal"
            style="@style/OverlayTextButton"
            android:layout_marginStart="6dp"
            android:drawableStart="@drawable/ic_nav_devices"
            android:text="@string/search_devices" />
    </LinearLayout>

    <HorizontalScrollView
        android:id="@+id/controls_panel"
        android:layout_width="wrap_content"
        android:layout_height="58dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="14dp"
        android:background="@drawable/card"
        android:elevation="16dp"
        android:fillViewport="true"
        android:paddingHorizontal="8dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button android:id="@+id/pause_button" style="@style/ControlButton" android:drawableTop="@drawable/ic_pause" android:text="@string/pause_recording" android:visibility="gone" />
            <Button android:id="@+id/snapshot_button" style="@style/ControlButton" android:drawableTop="@drawable/ic_snapshot" android:text="@string/screenshot" />
            <Button android:id="@+id/record_button" style="@style/ControlButton" android:drawableTop="@drawable/ic_record" android:text="@string/record" />
            <Button android:id="@+id/recording_audio_button" style="@style/ControlButton" android:drawableTop="@drawable/ic_audio" android:text="@string/recording_audio_button" />
            <Button android:id="@+id/watermark_button" style="@style/ControlButton" android:drawableTop="@drawable/ic_watermark" android:text="@string/watermark_tools" />
            <Button android:id="@+id/fit_button" style="@style/ControlButton" android:drawableTop="@drawable/ic_fit" android:text="@string/fit_video" />
            <Button android:id="@+id/video_crop_button" style="@style/ControlButton" android:drawableTop="@drawable/ic_crop" android:text="@string/video_crop_select" />
            <Button android:id="@+id/fullscreen_button" style="@style/ControlButton" android:contentDescription="@string/enter_fullscreen_description" android:drawableTop="@drawable/ic_fullscreen" android:text="@string/fullscreen" />
            <Button android:id="@+id/digital_zoom_button" style="@style/ControlButton" android:contentDescription="@string/digital_zoom_title" android:drawableTop="@drawable/ic_zoom" android:text="@string/digital_zoom_title" />
            <Button android:id="@+id/close_preview_button" style="@style/ControlButton" android:contentDescription="@string/close_preview" android:drawableTop="@drawable/ic_close" android:text="@string/close_preview" />
            <Button android:id="@+id/controls_collapse" style="@style/ControlButton" android:contentDescription="@string/hide_controls" android:drawableTop="@drawable/ic_chevron_down" android:text="@string/hide_controls" />
        </LinearLayout>
    </HorizontalScrollView>

    <ImageButton
        android:id="@+id/controls_reveal"
        style="@style/OverlayHandleButton"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="10dp"
        android:contentDescription="@string/expand_panel"
        android:padding="10dp"
        android:src="@drawable/ic_chevron_up"
        android:visibility="gone" />

</FrameLayout>
