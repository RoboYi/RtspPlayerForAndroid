<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/push_config_panel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/card"
    android:elevation="16dp"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/camera_push_title"
            android:textColor="@color/ink"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/push_config_collapse"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/collapse_panel"
            android:padding="7dp"
            android:src="@drawable/ic_chevron_right" />
    </LinearLayout>

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/camera_push_source" android:textColor="@color/muted" android:textSize="12sp" />
    <Spinner android:id="@+id/camera_push_source_spinner" android:layout_width="match_parent" android:layout_height="46dp" android:background="@drawable/outline_button" android:paddingHorizontal="8dp" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/camera_push_resolution" android:textColor="@color/muted" android:textSize="12sp" />
            <Spinner android:id="@+id/camera_push_size_spinner" android:layout_width="match_parent" android:layout_height="46dp" android:background="@drawable/outline_button" android:paddingHorizontal="8dp" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/camera_push_fps" android:textColor="@color/muted" android:textSize="12sp" />
            <Spinner android:id="@+id/camera_push_fps_spinner" android:layout_width="match_parent" android:layout_height="46dp" android:background="@drawable/outline_button" android:paddingHorizontal="8dp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/camera_push_codec" android:textColor="@color/muted" android:textSize="12sp" />
            <Spinner android:id="@+id/camera_push_codec_spinner" android:layout_width="match_parent" android:layout_height="46dp" android:background="@drawable/outline_button" android:paddingHorizontal="8dp" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/camera_push_bitrate" android:textColor="@color/muted" android:textSize="12sp" />
            <EditText
                android:id="@+id/camera_push_bitrate_input"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:background="@drawable/outline_button"
                android:inputType="number"
                android:paddingHorizontal="12dp"
                android:singleLine="true"
                android:text="2500"
                android:textColor="@color/ink" />
        </LinearLayout>
    </LinearLayout>

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/camera_push_path" android:textColor="@color/muted" android:textSize="12sp" />
    <EditText
        android:id="@+id/camera_push_path_input"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:background="@drawable/outline_button"
        android:inputType="textUri"
        android:paddingHorizontal="12dp"
        android:singleLine="true"
        android:text="live/camera"
        android:textColor="@color/ink" />

    <TextView
        android:id="@+id/camera_push_osd_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/push_osd_none"
        android:textColor="@color/muted"
        android:textSize="12sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/push_address_title"
        android:textColor="@color/muted"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/camera_push_url"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/outline_button"
        android:padding="12dp"
        android:text="@string/runtime_unknown"
        android:textColor="@color/ink"
        android:textIsSelectable="true"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/camera_push_uvc_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/camera_push_uvc_none"
        android:textColor="@color/muted"
        android:textSize="11sp" />
</LinearLayout>
