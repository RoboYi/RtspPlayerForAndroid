<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/card"
    android:fillViewport="true"
    android:scrollbars="none">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sidebar_title"
            android:textColor="@color/ink"
            android:textSize="20sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="@string/sidebar_subtitle"
            android:textColor="@color/muted"
            android:textSize="12sp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">
            <Button
                android:id="@+id/history_tab"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/primary_button"
                android:text="@string/tab_history"
                android:textAllCaps="false"
                android:textColor="#FFFFFF" />
            <Button
                android:id="@+id/onvif_tab"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/outline_button"
                android:text="@string/tab_devices"
                android:textAllCaps="false"
                android:textColor="@color/blue" />
            <Button
                android:id="@+id/captures_tab"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/outline_button"
                android:text="@string/tab_files"
                android:textAllCaps="false"
                android:textColor="@color/blue" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/history_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/recent_connections"
                android:textColor="@color/ink"
                android:textSize="15sp"
                android:textStyle="bold" />
            <LinearLayout
                android:id="@+id/history_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />
            <Button
                android:id="@+id/clear_history"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_gravity="end"
                android:background="@android:color/transparent"
                android:text="@string/clear_history"
                android:textAllCaps="false"
                android:textColor="#E14747" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/captures_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical"
            android:visibility="gone">
            <TextView
                android:id="@+id/captures_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/captures_title"
                android:textColor="@color/ink"
                android:textSize="15sp"
                android:textStyle="bold" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">
                <Button
                    android:id="@+id/refresh_captures"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:background="@drawable/outline_button"
                    android:text="@string/refresh_list"
                    android:textAllCaps="false"
                    android:textColor="@color/blue" />
                <Button
                    android:id="@+id/delete_captures"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/outline_button"
                    android:enabled="false"
                    android:text="@string/delete_selected"
                    android:textAllCaps="false"
                    android:textColor="#E14747" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/captures_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/onvif_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical"
            android:visibility="gone">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/device_discovery_title"
                android:textColor="@color/ink"
                android:textSize="15sp"
                android:textStyle="bold" />
            <EditText
                android:id="@+id/onvif_user"
                android:importantForAutofill="no"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/outline_button"
                android:hint="@string/username"
                android:inputType="text"
                android:saveEnabled="false"
                android:paddingHorizontal="12dp"
                android:singleLine="true"
                android:textSize="14sp" />
            <EditText
                android:id="@+id/onvif_password"
                android:importantForAutofill="no"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/outline_button"
                android:hint="@string/password"
                android:inputType="textPassword"
                android:saveEnabled="false"
                android:paddingHorizontal="12dp"
                android:singleLine="true"
                android:textSize="14sp" />
            <Button
                android:id="@+id/search_button"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/primary_button"
                android:text="@string/search_devices"
                android:textAllCaps="false"
                android:textColor="#FFFFFF" />
            <TextView
                android:id="@+id/onvif_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/discovery_description"
                android:textColor="@color/muted"
                android:textSize="12sp" />
            <LinearLayout
                android:id="@+id/device_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
